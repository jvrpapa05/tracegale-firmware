 *
 * A simulated flash with the partition that Zephyr's flash coredump backend writes to.
 */

/ {
	sim_flash_controller: sim-flash-controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		/* Zephyr v3.7's simulator finds its flash by this name. */
		sim_flash: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 0x4000>;
			erase-block-size = <4096>;
			write-block-size = <4>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				coredump_partition: partition@0 {
					label = "coredump";
					reg = <0x0 0x4000>;
				};
			};
		};
	};
};
