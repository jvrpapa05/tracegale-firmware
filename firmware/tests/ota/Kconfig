# These tests need CONFIG_BOOTLOADER_MCUBOOT on native_sim, where a stand-in plays MCUboot. Before Zephyr v4.5 that option
# can't be chosen there, because it wants an image that's linked at an offset in flash. Nothing is linked differently for
# native_sim, so saying yes here is safe, and only these tests do it.
config HAS_FLASH_LOAD_OFFSET
	default y

source "Kconfig.zephyr"
